[binaries]
c = 'x86_64-w64-mingw32-gcc'
cpp = 'x86_64-w64-mingw32-g++'
ar = 'x86_64-w64-mingw32-gcc-ar'
strip = 'x86_64-w64-mingw32-strip'
windres = 'x86_64-w64-mingw32-windres'
pkg-config = 'pkg-config'

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['-O2', '-g0', '-I/work/prefix/include', '-ffile-prefix-map=/work=.', '-fno-ident']
cpp_args = ['-O2', '-g0', '-I/work/prefix/include', '-ffile-prefix-map=/work=.', '-fno-ident']
c_link_args = ['-L/work/prefix/lib', '-static-libgcc', '-static-libstdc++', '-Wl,--no-insert-timestamp']
cpp_link_args = ['-L/work/prefix/lib', '-static-libgcc', '-static-libstdc++', '-Wl,--no-insert-timestamp']
